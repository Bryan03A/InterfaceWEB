import java.security.MessageDigest;
import java.security.NoSuchAlgorithmException;
import java.util.*;
import java.io.*;
import java.util.Base64;

public class HashPasswordWithStorage {

    private static final String FILE_NAME = "passwords.db";
    private static Map<String, String> hashToPassword = new HashMap<>();

    public static void main(String[] args) {
        // Cargar base de datos al inicio
        loadDatabase();

        Scanner scanner = new Scanner(System.in);

        while (true) {
            System.out.println("\nOpciones:");
            System.out.println("1. Guardar contraseña");
            System.out.println("2. Buscar contraseña por SHA-256");
            System.out.println("3. Salir");
            System.out.print("Elige una opción: ");
            String option = scanner.nextLine();

            switch (option) {
                case "1":
                    System.out.print("Contraseña: ");
                    String password = scanner.nextLine();
                    String hash = sha256(password);

                    hashToPassword.put(hash.toLowerCase(), password);
                    saveDatabase(); // Guardar inmediatamente
                    System.out.println("Contraseña guardada en archivo. SHA-256: " + hash);
                    break;

                case "2":
                    System.out.print("Introduce SHA-256: ");
                    String inputHash = scanner.nextLine().toLowerCase();

                    String foundPassword = hashToPassword.get(inputHash);
                    if (foundPassword != null) {
                        System.out.println("Contraseña original encontrada: " + foundPassword);
                    } else {
                        System.out.println("No se encontró ninguna contraseña con ese hash.");
                    }
                    break;

                case "3":
                    System.out.println("Saliendo...");
                    scanner.close();
                    return;

                default:
                    System.out.println("Opción inválida.");
            }
        }
    }

    // Generar SHA-256
    public static String sha256(String input) {
        try {
            MessageDigest digest = MessageDigest.getInstance("SHA-256");
            byte[] hash = digest.digest(input.getBytes());

            StringBuilder hex = new StringBuilder();
            for (byte b : hash) {
                String h = Integer.toHexString(0xff & b);
                if (h.length() == 1) hex.append('0');
                hex.append(h);
            }
            return hex.toString();
        } catch (NoSuchAlgorithmException e) {
            throw new RuntimeException(e);
        }
    }

    // Guardar base de datos en archivo (ofuscado)
    private static void saveDatabase() {
        try (BufferedWriter writer = new BufferedWriter(new FileWriter(FILE_NAME))) {
            for (Map.Entry<String, String> entry : hashToPassword.entrySet()) {
                String line = entry.getKey() + ":" + entry.getValue();
                // Ofuscamos con Base64 y luego invertimos
                String encoded = new StringBuilder(Base64.getEncoder().encodeToString(line.getBytes())).reverse().toString();
                writer.write(encoded);
                writer.newLine();
            }
        } catch (IOException e) {
            System.out.println("Error guardando la base de datos: " + e.getMessage());
        }
    }

    // Cargar base de datos desde archivo
    private static void loadDatabase() {
        File file = new File(FILE_NAME);
        if (!file.exists()) return;

        try (BufferedReader reader = new BufferedReader(new FileReader(file))) {
            String line;
            while ((line = reader.readLine()) != null) {
                // Desofuscamos: revertimos la cadena y luego decodificamos Base64
                String decoded = new String(Base64.getDecoder().decode(new StringBuilder(line).reverse().toString()));
                String[] parts = decoded.split(":", 2);
                if (parts.length == 2) {
                    hashToPassword.put(parts[0], parts[1]);
                }
            }
        } catch (IOException e) {
            System.out.println("Error cargando la base de datos: " + e.getMessage());
        }
    }
}