import javax.swing.*;
import java.awt.*;
import java.awt.event.*;
import java.io.*;
import java.security.MessageDigest;
import java.security.NoSuchAlgorithmException;
import java.util.Base64;
import java.util.HashMap;
import java.util.Map;

public class HashPasswordGUI extends JFrame {

    private static final String FILE_NAME = "passwords.db";
    private static Map<String, String> hashToPassword = new HashMap<>();

    private JTextField passwordField, hashField, resultField;

    public HashPasswordGUI() {
        setTitle("SHA-256 Password Manager");
        setSize(500, 250);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLocationRelativeTo(null);
        setLayout(new GridLayout(5, 2, 5, 5));

        // Cargar base de datos
        loadDatabase();

        add(new JLabel("Contraseña:"));
        passwordField = new JTextField();
        add(passwordField);

        JButton saveButton = new JButton("Guardar Contraseña");
        add(saveButton);
        saveButton.addActionListener(e -> savePassword());

        add(new JLabel("SHA-256 a buscar:"));
        hashField = new JTextField();
        add(hashField);

        JButton searchButton = new JButton("Buscar Contraseña");
        add(searchButton);
        searchButton.addActionListener(e -> searchPassword());

        add(new JLabel("Resultado:"));
        resultField = new JTextField();
        resultField.setEditable(false);
        add(resultField);
    }

    private void savePassword() {
        String password = passwordField.getText();
        if (password.isEmpty()) {
            JOptionPane.showMessageDialog(this, "Introduce una contraseña.");
            return;
        }
        String hash = sha256(password);
        hashToPassword.put(hash.toLowerCase(), password);
        saveDatabase();
        JOptionPane.showMessageDialog(this, "Contraseña guardada.\nSHA-256: " + hash);
        passwordField.setText("");
    }

    private void searchPassword() {
        String inputHash = hashField.getText().toLowerCase();
        String found = hashToPassword.get(inputHash);
        if (found != null) {
            resultField.setText(found);
        } else {
            resultField.setText("No encontrada");
        }
    }

    private static String sha256(String input) {
        try {
            MessageDigest digest = MessageDigest.getInstance("SHA-256");
            byte[] hash = digest.digest(input.getBytes());

            StringBuilder hex = new StringBuilder();
            for (byte b : hash) {
                String h = Integer.toHexString(0xff & b);
                if (h.length() == 1) hex.append('0');
                hex.append(h);
            }
            return hex.toString();
        } catch (NoSuchAlgorithmException e) {
            throw new RuntimeException(e);
        }
    }

    private static void saveDatabase() {
        try (BufferedWriter writer = new BufferedWriter(new FileWriter(FILE_NAME))) {
            for (Map.Entry<String, String> entry : hashToPassword.entrySet()) {
                String line = entry.getKey() + ":" + entry.getValue();
                String encoded = new StringBuilder(Base64.getEncoder().encodeToString(line.getBytes())).reverse().toString();
                writer.write(encoded);
                writer.newLine();
            }
        } catch (IOException e) {
            JOptionPane.showMessageDialog(null, "Error guardando la base de datos: " + e.getMessage());
        }
    }

    private static void loadDatabase() {
        File file = new File(FILE_NAME);
        if (!file.exists()) return;

        try (BufferedReader reader = new BufferedReader(new FileReader(file))) {
            String line;
            while ((line = reader.readLine()) != null) {
                String decoded = new String(Base64.getDecoder().decode(new StringBuilder(line).reverse().toString()));
                String[] parts = decoded.split(":", 2);
                if (parts.length == 2) {
                    hashToPassword.put(parts[0], parts[1]);
                }
            }
        } catch (IOException e) {
            JOptionPane.showMessageDialog(null, "Error cargando la base de datos: " + e.getMessage());
        }
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> {
            new HashPasswordGUI().setVisible(true);
        });
    }
}