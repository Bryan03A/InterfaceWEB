import java.security.MessageDigest;
import java.security.NoSuchAlgorithmException;
import java.util.HashMap;
import java.util.Map;
import java.util.Scanner;

public class HashPasswordOptimized {

    // Base de datos en memoria: hash -> contraseña original
    private static Map<String, String> hashToPassword = new HashMap<>();

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        while (true) {
            System.out.println("\nOpciones:");
            System.out.println("1. Guardar contraseña");
            System.out.println("2. Buscar contraseña por SHA-256");
            System.out.println("3. Salir");
            System.out.println("4. Listar todas las contraseñas guardadas");
            System.out.print("Elige una opción: ");
            String option = scanner.nextLine();

            switch (option) {
                case "1":
                    System.out.print("Contraseña: ");
                    String password = scanner.nextLine();
                    String hash = sha256(password);

                    hashToPassword.put(hash.toLowerCase(), password);
                    System.out.println("Contraseña guardada en memoria. SHA-256: " + hash);
                    break;

                case "2":
                    System.out.print("Introduce SHA-256: ");
                    String inputHash = scanner.nextLine().toLowerCase();

                    String foundPassword = hashToPassword.get(inputHash);
                    if (foundPassword != null) {
                        System.out.println("Contraseña original encontrada: " + foundPassword);
                    } else {
                        System.out.println("No se encontró ninguna contraseña con ese hash.");
                    }
                    break;

                case "3":
                    System.out.println("Saliendo...");
                    scanner.close();
                    return;

                case "4":
                    if (hashToPassword.isEmpty()) {
                        System.out.println("No hay contraseñas guardadas.");
                    } else {
                        System.out.println("Listado de contraseñas guardadas:");
                        for (Map.Entry<String, String> entry : hashToPassword.entrySet()) {
                            System.out.println("Contraseña: " + entry.getValue() + " | SHA-256: " + entry.getKey());
                        }
                    }
                    break;

                default:
                    System.out.println("Opción inválida.");
            }
        }
    }

    // Función para calcular SHA-256
    public static String sha256(String input) {
        try {
            MessageDigest digest = MessageDigest.getInstance("SHA-256");
            byte[] hash = digest.digest(input.getBytes());

            StringBuilder hex = new StringBuilder();
            for (byte b : hash) {
                String h = Integer.toHexString(0xff & b);
                if (h.length() == 1) hex.append('0');
                hex.append(h);
            }
            return hex.toString();
        } catch (NoSuchAlgorithmException e) {
            throw new RuntimeException(e);
        }
    }
}